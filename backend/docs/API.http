### ============================================================
### MODÉRATION
### ============================================================

### Signaler une publication
POST {{baseUrl}}/moderation/signalements
Authorization: Bearer {{jetonAcces}}
Content-Type: application/json

{
  "codePublication": "{{codePublication}}",
  "motif": "Contenu inapproprié",
  "details": "Description détaillée du problème rencontré."
}

GET {{baseUrl}}/moderation/signalements?statut=OUVERT&page=1&limite=20
Authorization: Bearer {{jetonAcces}}

### Traiter un signalement - Administrateur
PATCH {{baseUrl}}/moderation/signalements/{{codeSignalement}}
Authorization: Bearer {{jetonAcces}}
Content-Type: application/json

{
  "statut": "RESOLU",
  "resolution": "Le contenu a été examiné et la décision a été enregistrée."
}

### ============================================================
### NOTIFICATIONS
### ============================================================

GET {{baseUrl}}/notifications?nonLues=true&page=1&limite=20
Authorization: Bearer {{jetonAcces}}

PATCH {{baseUrl}}/notifications/tout-lire
Authorization: Bearer {{jetonAcces}}

PATCH {{baseUrl}}/notifications/{{codeNotification}}/lire
Authorization: Bearer {{jetonAcces}}

DELETE {{baseUrl}}/notifications/{{codeNotification}}
Authorization: Bearer {{jetonAcces}}

### ============================================================
### ADMINISTRATION
### ============================================================

GET {{baseUrl}}/administration/tableau-de-bord
Authorization: Bearer {{jetonAcces}}

GET {{baseUrl}}/administration/audit?typeEntite=UNIVERSITE&page=1&limite=30
Authorization: Bearer {{jetonAcces}}

### Vérifier une université
PATCH {{baseUrl}}/administration/universites/{{codeUniversite}}/verification
Authorization: Bearer {{jetonAcces}}
Content-Type: application/json

{
  "statut": "VERIFIEE"
}
