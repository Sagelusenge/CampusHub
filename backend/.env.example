NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=votre_mot_de_passe_mysql
DB_NAME=campushub
DB_CONNECTION_LIMIT=10

JWT_SECRET=remplacez_cette_valeur_par_un_secret_long_et_aleatoire
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_DAYS=30
BCRYPT_ROUNDS=12

# Confirmation des adresses e-mail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=votre_adresse@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application
SMTP_FROM=CampusHub <votre_adresse@gmail.com>
ADMIN_NOTIFICATION_EMAIL=administration@campushub.cd
EMAIL_VERIFICATION_TTL_MINUTES=10
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# CampusHubIA — agent local, aucune API d'IA externe
CAMPUSHUB_IA_URL=http://127.0.0.1:5000
CAMPUSHUB_IA_TOKEN=
CAMPUSHUB_IA_MODEL=campushub-ia-local-v1
CAMPUSHUB_IA_TIMEOUT_MS=8000

# Enrichissement documentaire public (Wikipedia, sans clé d’API)
CAMPUSHUB_WEB_ENABLED=true
CAMPUSHUB_WEB_TIMEOUT_MS=3500
CAMPUSHUB_WEB_MAX_SOURCES=2
